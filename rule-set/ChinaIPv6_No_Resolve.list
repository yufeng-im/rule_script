# NAME: 中国 IPv6 顶级骨干网与云厂商
# REPO: https://github.com/yufeng-im
# UPDATED: 2026-11-18
# POLICY: 严格采用 APNIC 分配给中国大陆实体的精确前缀，杜绝 /16 超大段误伤日本/亚太运营商

# === 中国四大基础电信运营商 IPv6 骨干网 ===
# 中国电信（CT-IPv6-Networks）
IP-CIDR6,240e::/18,no-resolve
# 中国联通（CU-CN）
IP-CIDR6,2408:8000::/20,no-resolve
# 中国移动（CMNET-V6）
IP-CIDR6,2409:8000::/20,no-resolve
# 中国广电（CBN-CN）
IP-CIDR6,240a:4000::/21,no-resolve

# === 中国教育和科研计算机网（CERNET / CERNET2）与科技网（CSTNET）===
# 教育网 CERNET / CNGI-CERNET2 核心分配段
IP-CIDR6,240c:c000::/20,no-resolve
IP-CIDR6,2001:da8::/32,no-resolve
IP-CIDR6,2001:250::/32,no-resolve
IP-CIDR6,2001:251::/32,no-resolve
# 中国科技网 CSTNET（中科院）
IP-CIDR6,2400:dd00::/28,no-resolve

# === 中国顶级云厂商大陆专属 IPv6 网段 ===
# 阿里云 Alibaba Cloud（ALISOFT 大陆）
IP-CIDR6,2400:3200::/32,no-resolve
IP-CIDR6,2408:4000::/22,no-resolve
# 腾讯云 Tencent Cloud（大陆核心段）
IP-CIDR6,2402:4e00::/32,no-resolve
# 百度智能云 Baidu Cloud（大陆核心段）
IP-CIDR6,2400:da00::/32,no-resolve
IP-CIDR6,240c:4000::/22,no-resolve
# 华为云 Huawei Cloud（HWCLOUD 大陆专属段）
IP-CIDR6,2409:1000::/20,no-resolve
